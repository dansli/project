--- 上机库存
WITH
    last_stock AS (
        SELECT
            extract_time,
            custom_id,
            machine_id,
            sku,
            ROW_NUMBER() OVER (
                PARTITION BY
                    date_format (extract_time, '%Y-%m-%d'),
                    custom_id,
                    machine_id,
                    sku
                ORDER BY
                    extract_time DESC
            ) AS rn
        FROM
            sds.hy_get_machine_slots_info_recode
        where
            custom_id not like '%popdatalink%'
    ),
    -- 每天最后一次库存
    stock_slot as (
        select
            extract_time,
            custom_id,
            machine_id,
            count(distinct sku) as sku_count_slot
        from
            last_stock
        where
            rn = 1
        group by
            extract_time,
            custom_id,
            machine_id
    ),
    -- 机器总库存
    stock_robo as (
        select
            zcalday,
            location_txt,
            locationID as warehouse_id,
            count(distinct item_code) as sku_count_robo
        from
            ns.zmm_dwb002
        where
            locationtype = 'robo shop'
        group by
            zcalday,
            location_txt,
            locationID
    )
select
    date_format (s.extract_time, '%Y-%m-%d'),
    s.extract_time,
    s.custom_id,
    s.machine_id,
    r.warehouse_id,
    s.sku_count_slot,
    r.sku_count_robo
from
    stock_slot as s
    left join stock_robo as r on s.machine_id = REGEXP_SUBSTR (r.location_txt, 'R[A-Z0-9]{2}-[A-Z0-9]{4}', 1, 1)
    and date_format (s.extract_time, '%Y-%m-%d') = r.date_format (zcalday, '%Y-%m-%d')